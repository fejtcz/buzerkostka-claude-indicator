#!/usr/bin/env python3
"""Main CLI entry point.

Deliberately runnable straight out of a git clone: it puts ``src/`` on
``sys.path`` itself, so there is no install step, no virtualenv and no
dependency to resolve.
"""

import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"
    ),
)

from buzerkostka.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
